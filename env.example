# DEVELOPMENT ONLY (for Railway set APP_ENV=production)
APP_ENV=development
DATABASE_URL=sqlite:///./enjaz_local.db
APP_BASE_URL=http://localhost:8000
# Configure these ONLY during initial provisioning. Remove them after administrator logs in.
BOOTSTRAP_ADMIN_EMAIL=admin@your-organization.example
BOOTSTRAP_ADMIN_PASSWORD=GENERATE_A_UNIQUE_RANDOM_PASSWORD_OF_20_PLUS_CHARS
